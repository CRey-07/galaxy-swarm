# ==============================================================
# Galaxy Swarm — environment configuration
# Copy this file to `.env` for local development, or set these as
# environment variables directly in Coolify's application settings.
# ==============================================================

# ---- Runtime ----

# Standard Node environment flag. Set to `production` on Coolify.
# Affects: startup log verbosity, and whether a missing ALLOWED_ORIGINS
# is logged as a WARNING (dev) or ERROR (production).
NODE_ENV=production

# Port the Node process listens on inside the container. Coolify maps this
# to the container's exposed port automatically — only change this if you
# also update the `EXPOSE`/port mapping in Dockerfile / docker-compose.yml.
PORT=3000

# ---- Security (required in production) ----

# Comma-separated list of exact allowed origins for CORS and the WebSocket
# handshake origin check, e.g.:
#   ALLOWED_ORIGINS=https://galaxyswarm.example.com,https://www.galaxyswarm.example.com
# Leaving this unset (or "*") accepts connections from ANY origin — fine for
# local development, but the server logs an ERROR at boot if this reaches
# production still unset. Always set this to your real domain(s) before
# going live.
ALLOWED_ORIGINS=https://galaxyswarm.example.com

# Optional: comma-separated extra words to add to the nickname profanity
# blocklist (src/server/sanitize.js), on top of the small built-in list.
PROFANITY_EXTRA=
